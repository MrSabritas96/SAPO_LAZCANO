        #region Puntos de Interacción
        private static void BuildInteractionZones(Transform root, Dictionary<string, Material> mats)
        {
            var zonesGroup = new GameObject("Interaction_Zones");
            zonesGroup.transform.SetParent(root, false);

            // 1. Recepción
            CreateInteractionPoint(
                zonesGroup.transform,
                "Zone_Reception",
                new Vector3(-4.0f, 0.5f, 1.8f),
                2.4f,
                "Puesto de Control y Recepción",
                "Recepción principal de la Base UTOP.\n\nAquí se realiza el registro obligatorio del personal que ingresa a las instalaciones, verificación de credenciales y asignación de áreas operativas.",
                "Consultar Libro de Novedades"
            );

            // 2. Sala de Reuniones
            CreateInteractionPoint(
                zonesGroup.transform,
                "Zone_MeetingRoom",
                new Vector3(6.5f, 0.5f, 3.0f),
                2.8f,
                "Sala de Reuniones Tácticas",
                "Espacio de coordinación y análisis táctico.\n\nLos oficiales y jefes de escuadra planifican aquí los despliegues preventivos, evalúan rutas de contingencia y analizan los informes de situación de los bloqueos urbanos.",
                "Revisar Orden del Día"
            );

            // 3. Aula de Formación
            CreateInteractionPoint(
                zonesGroup.transform,
                "Zone_Classroom",
                new Vector3(10f, 0.5f, 11.0f),
                3.0f,
                "Aula de Formación Especializada",
                "Centro de instrucción y capacitación de la UTOP.\n\nEn este recinto se dictan las materias de Derechos Humanos aplicados a la función policial, resolución pacífica de conflictos y técnicas no letales de contención.",
                "Examinar Manual de Formación"
            );

            // 4. Oficina de Mando
            CreateInteractionPoint(
                zonesGroup.transform,
                "Zone_CommandOffice",
                new Vector3(10f, 4.45f, 3.5f),
                2.8f,
                "Jefatura de Operaciones UTOP",
                "Área de acceso restringido.\n\nDespacho de la Jefatura Operativa. Solo personal autorizado con clave de mando puede ingresar para recibir órdenes directas de despliegue y autorización de recursos tácticos.",
                "Solicitar Audiencia con el Mando"
            );
        }

        private static void CreateInteractionPoint(
            Transform parent,
            string name,
            Vector3 pos,
            float radius,
            string title,
            string desc,
            string prompt)
        {
            var go = new GameObject(name);
            go.transform.SetParent(parent, false);
            go.transform.position = pos;

            var colTrigger = go.AddComponent<SphereCollider>();
            colTrigger.isTrigger = true;
            colTrigger.radius = radius;

            var zone = go.AddComponent<InteractableZone>();
            zone.zoneTitle = title;
            zone.interactionDescription = desc;
            zone.actionPrompt = prompt;
            zone.interactionRadius = radius;

            // Marcador visual sutil en el suelo (anillo/halo)
            var marker = GameObject.CreatePrimitive(PrimitiveType.Cylinder);
            marker.name = "Zone_Marker";
            marker.transform.SetParent(go.transform, false);
            marker.transform.localPosition = new Vector3(0, 0.02f, 0);
            marker.transform.localScale = new Vector3(radius * 0.85f, 0.01f, radius * 0.85f);
            var col = marker.GetComponent<Collider>();
            if (col != null) Object.DestroyImmediate(col);

            var rend = marker.GetComponent<MeshRenderer>();
            var markerMat = new Material(Shader.Find("Universal Render Pipeline/Lit"));
            markerMat.color = new Color(0.1f, 0.8f, 1.0f, 0.25f);
            if (markerMat.HasProperty("_EmissionColor"))
            {
                markerMat.EnableKeyword("_EMISSION");
                markerMat.SetColor("_EmissionColor", new Color(0.1f, 0.8f, 1.0f) * 0.8f);
            }
            rend.sharedMaterial = markerMat;
        }
        #endregion

        #region Jugador y Cámara
        private static GameObject BuildPlayer(Transform root, Dictionary<string, Material> mats)
        {
            // Posición de spawn: Patio frontal exterior (Z = -14, X = 0), mirando hacia la fachada (Z = 0)
            Vector3 spawnPos = new Vector3(0, 0.05f, -14f);
            Quaternion spawnRot = Quaternion.identity;

            var playerGo = new GameObject("Player_Oficial");
            playerGo.transform.position = spawnPos;
            playerGo.transform.rotation = spawnRot;
            playerGo.tag = "Player";

            // CharacterController para movimiento con colisiones y suelo
            var cc = playerGo.AddComponent<CharacterController>();
            cc.height = 1.85f;
            cc.radius = 0.32f;
            cc.center = new Vector3(0, 0.925f, 0);
            cc.stepOffset = 0.35f; // Permite subir escalones con soltura
            cc.slopeLimit = 45f;

            // Construir modelo anatómico articulado completo
            var humanoid = HumanoidModelBuilder.BuildHumanoid(
                playerGo,
                mats["Mat_UTOP_Concrete_Accent"], // Cuerpo azul oscuro / grafito
                mats["Mat_UTOP_Metal_Dark"],       // Articulaciones
                mats["Mat_UTOP_Gold_Brass"],       // Acento dorado
                mats["Mat_UTOP_Screen_Tactical"]   // Visor
            );

            // Animador procedural biomecánico
            var animator = playerGo.AddComponent<ProceduralHumanoidAnimator>();
            animator.humanoid = humanoid;
            animator.CaptureInitialPoses();

            // Controlador del jugador WASD + Shift
            var pc = playerGo.AddComponent<PlayerController>();

            // Configurar Cámara Orbital 3ra Persona
            var camGo = new GameObject("Main Camera");
            camGo.tag = "MainCamera";
            var cam = camGo.AddComponent<Camera>();
            cam.nearClipPlane = 0.1f;
            cam.farClipPlane = 1000f;
            camGo.AddComponent<AudioListener>();
            camGo.AddComponent<UniversalAdditionalCameraData>();

            var tpCam = camGo.AddComponent<ThirdPersonCamera>();
            tpCam.target = playerGo.transform;
            tpCam.distance = 3.8f;
            tpCam.targetOffset = new Vector3(0, 1.4f, 0);

            pc.cameraTransform = camGo.transform;
            camGo.transform.position = spawnPos + new Vector3(0, 2.2f, -3.8f);
            camGo.transform.LookAt(spawnPos + new Vector3(0, 1.4f, 0));

            return playerGo;
        }
        #endregion

        #region HUD de Simulación e Interacción
        private static void BuildUIHierarchy(GameObject player)
        {
            var canvasGo = new GameObject("Simulation_Canvas");
            var canvas = canvasGo.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvas.sortingOrder = 100;

            var scaler = canvasGo.AddComponent<CanvasScaler>();
            scaler.uiScaleMode = CanvasScaler.ScaleMode.ScaleWithScreenSize;
            scaler.referenceResolution = new Vector2(1920, 1080);
            scaler.screenMatchMode = CanvasScaler.ScreenMatchMode.MatchWidthOrHeight;
            scaler.matchWidthOrHeight = 0.5f;

            canvasGo.AddComponent<GraphicRaycaster>();

            // EventSystem si no existe
            if (Object.FindAnyObjectByType<UnityEngine.EventSystems.EventSystem>() == null)
            {
                var esGo = new GameObject("EventSystem");
                esGo.AddComponent<UnityEngine.EventSystems.EventSystem>();
                esGo.AddComponent<UnityEngine.InputSystem.UI.InputSystemUIInputModule>();
            }

            // Fuente TextMeshPro
            var fontAsset = Resources.Load<TMP_FontAsset>("Fonts & Materials/LiberationSans SDF");
            if (fontAsset == null)
            {
                fontAsset = TMP_Settings.defaultFontAsset;
            }

            // 1. BANNER SUPERIOR DE INFORMACIÓN DEL OFICIAL (Esquina Superior Izquierda)
            var topBanner = new GameObject("TopBanner_OfficerInfo", typeof(RectTransform), typeof(Image));
            topBanner.transform.SetParent(canvasGo.transform, false);
            var tbRect = topBanner.GetComponent<RectTransform>();
            tbRect.anchorMin = new Vector2(0, 1);
            tbRect.anchorMax = new Vector2(0, 1);
            tbRect.pivot = new Vector2(0, 1);
            tbRect.anchoredPosition = new Vector2(25, -25);
            tbRect.sizeDelta = new Vector2(440, 100);
            var tbImg = topBanner.GetComponent<Image>();
            tbImg.color = new Color(0.06f, 0.08f, 0.11f, 0.88f);

            // Borde estético izquierdo
            var borderL = new GameObject("Accent_Border", typeof(RectTransform), typeof(Image));
            borderL.transform.SetParent(topBanner.transform, false);
            var bRect = borderL.GetComponent<RectTransform>();
            bRect.anchorMin = new Vector2(0, 0);
            bRect.anchorMax = new Vector2(0, 1);
            bRect.pivot = new Vector2(0, 0.5f);
            bRect.sizeDelta = new Vector2(4, 0);
            borderL.GetComponent<Image>().color = new Color(0f, 0.85f, 1f, 0.9f);

            var titleText = CreateText(topBanner.transform, "Title", "SIMULADOR DE BLOQUEOS — BASE UTOP", 13, FontStyles.Bold, new Color(0f, 0.85f, 1f), fontAsset);
            titleText.rectTransform.anchoredPosition = new Vector2(18, -16);

            var officerText = CreateText(topBanner.transform, "OfficerName", "Subt. Oficial en Prácticas", 16, FontStyles.Bold, Color.white, fontAsset);
            officerText.rectTransform.anchoredPosition = new Vector2(18, -42);

            var codeText = CreateText(topBanner.transform, "OfficerCode", "POL-2026-UTOP | Sección Instrucción", 12, FontStyles.Normal, new Color(0.7f, 0.75f, 0.8f), fontAsset);
            codeText.rectTransform.anchoredPosition = new Vector2(18, -70);

            // 2. BOTÓN DE SALIDA AL MENÚ (Esquina Superior Derecha)
            var returnBtnGo = new GameObject("Btn_ReturnMenu", typeof(RectTransform), typeof(Image), typeof(Button));
            returnBtnGo.transform.SetParent(canvasGo.transform, false);
            var rbRect = returnBtnGo.GetComponent<RectTransform>();
            rbRect.anchorMin = new Vector2(1, 1);
            rbRect.anchorMax = new Vector2(1, 1);
            rbRect.pivot = new Vector2(1, 1);
            rbRect.anchoredPosition = new Vector2(-25, -25);
            rbRect.sizeDelta = new Vector2(170, 42);
            returnBtnGo.GetComponent<Image>().color = new Color(0.12f, 0.15f, 0.20f, 0.9f);

            var btnText = CreateText(returnBtnGo.transform, "Text", "Volver al Menú", 14, FontStyles.Bold, Color.white, fontAsset);
            btnText.alignment = TextAlignmentOptions.Center;
            btnText.rectTransform.anchorMin = Vector2.zero;
            btnText.rectTransform.anchorMax = Vector2.one;
            btnText.rectTransform.sizeDelta = Vector2.zero;
            btnText.rectTransform.anchoredPosition = Vector2.zero;

            // Script SimulationBaseHUD
            var baseHUD = canvasGo.AddComponent<SimulationBaseHUD>();
            baseHUD.rankAndNameText = officerText;
            baseHUD.codeAndUnitText = codeText;
            baseHUD.returnMenuButton = returnBtnGo.GetComponent<Button>();

            // 3. PROMPT DE INTERACCIÓN FLOTANTE (Abajo Centro)
            var promptGo = new GameObject("Prompt_Container", typeof(RectTransform), typeof(Image));
            promptGo.transform.SetParent(canvasGo.transform, false);
            var pRect = promptGo.GetComponent<RectTransform>();
            pRect.anchorMin = new Vector2(0.5f, 0);
            pRect.anchorMax = new Vector2(0.5f, 0);
            pRect.pivot = new Vector2(0.5f, 0);
            pRect.anchoredPosition = new Vector2(0, 50);
            pRect.sizeDelta = new Vector2(650, 52);
            promptGo.GetComponent<Image>().color = new Color(0.05f, 0.07f, 0.10f, 0.92f);

            var pText = CreateText(promptGo.transform, "Prompt_Text", "Presiona [E] para interactuar", 15, FontStyles.Normal, Color.white, fontAsset);
            pText.alignment = TextAlignmentOptions.Center;
            pText.rectTransform.anchorMin = Vector2.zero;
            pText.rectTransform.anchorMax = Vector2.one;
            pText.rectTransform.sizeDelta = Vector2.zero;
            pText.rectTransform.anchoredPosition = Vector2.zero;

            // 4. MODAL DETALLADO DE INFORMACIÓN TÁCTICA (Centro de pantalla)
            var modalGo = new GameObject("Modal_Container", typeof(RectTransform), typeof(Image));
            modalGo.transform.SetParent(canvasGo.transform, false);
            var mRect = modalGo.GetComponent<RectTransform>();
            mRect.anchorMin = new Vector2(0.5f, 0.5f);
            mRect.anchorMax = new Vector2(0.5f, 0.5f);
            mRect.pivot = new Vector2(0.5f, 0.5f);
            mRect.sizeDelta = new Vector2(680, 420);
            modalGo.GetComponent<Image>().color = new Color(0.08f, 0.10f, 0.13f, 0.98f);

            // Cabecera modal
            var headerGo = new GameObject("Modal_Header", typeof(RectTransform), typeof(Image));
            headerGo.transform.SetParent(modalGo.transform, false);
            var hRect = headerGo.GetComponent<RectTransform>();
            hRect.anchorMin = new Vector2(0, 1);
            hRect.anchorMax = new Vector2(1, 1);
            hRect.pivot = new Vector2(0.5f, 1);
            hRect.sizeDelta = new Vector2(0, 54);
            headerGo.GetComponent<Image>().color = new Color(0.12f, 0.15f, 0.20f, 1f);

            var modalTitle = CreateText(headerGo.transform, "ModalTitle", "INFORME TÁCTICO DE ZONA", 16, FontStyles.Bold, new Color(0f, 0.85f, 1f), fontAsset);
            modalTitle.alignment = TextAlignmentOptions.Center;
            modalTitle.rectTransform.anchorMin = Vector2.zero;
            modalTitle.rectTransform.anchorMax = Vector2.one;
            modalTitle.rectTransform.sizeDelta = Vector2.zero;
            modalTitle.rectTransform.anchoredPosition = Vector2.zero;

            var modalBody = CreateText(modalGo.transform, "ModalBody", "Descripción de la zona...", 15, FontStyles.Normal, new Color(0.9f, 0.92f, 0.95f), fontAsset);
            modalBody.rectTransform.anchorMin = new Vector2(0, 0);
            modalBody.rectTransform.anchorMax = new Vector2(1, 1);
            modalBody.rectTransform.pivot = new Vector2(0.5f, 0.5f);
            modalBody.rectTransform.anchoredPosition = new Vector2(0, -10);
            modalBody.rectTransform.sizeDelta = new Vector2(-60, -130);

            // Botón cerrar modal
            var closeBtnGo = new GameObject("Btn_CloseModal", typeof(RectTransform), typeof(Image), typeof(Button));
            closeBtnGo.transform.SetParent(modalGo.transform, false);
            var cRect = closeBtnGo.GetComponent<RectTransform>();
            cRect.anchorMin = new Vector2(0.5f, 0);
            cRect.anchorMax = new Vector2(0.5f, 0);
            cRect.pivot = new Vector2(0.5f, 0);
            cRect.anchoredPosition = new Vector2(0, 20);
            cRect.sizeDelta = new Vector2(200, 42);
            closeBtnGo.GetComponent<Image>().color = new Color(0.18f, 0.24f, 0.32f, 1f);

            var closeBtnText = CreateText(closeBtnGo.transform, "CloseText", "[E] / [ESC] Cerrar", 14, FontStyles.Bold, Color.white, fontAsset);
            closeBtnText.alignment = TextAlignmentOptions.Center;
            closeBtnText.rectTransform.anchorMin = Vector2.zero;
            closeBtnText.rectTransform.anchorMax = Vector2.one;
            closeBtnText.rectTransform.sizeDelta = Vector2.zero;
            closeBtnText.rectTransform.anchoredPosition = Vector2.zero;

            // Script InteractionHUD
            var interactionHUD = canvasGo.AddComponent<InteractionHUD>();
            interactionHUD.promptContainer = promptGo;
            interactionHUD.promptText = pText;
            interactionHUD.modalContainer = modalGo;
            interactionHUD.modalTitleText = modalTitle;
            interactionHUD.modalBodyText = modalBody;
            interactionHUD.modalCloseButton = closeBtnGo.GetComponent<Button>();

            // Guía de controles en esquina inferior derecha
            var controlsGuideGo = new GameObject("Controls_Guide", typeof(RectTransform), typeof(Image));
            controlsGuideGo.transform.SetParent(canvasGo.transform, false);
            var cgRect = controlsGuideGo.GetComponent<RectTransform>();
            cgRect.anchorMin = new Vector2(1, 0);
            cgRect.anchorMax = new Vector2(1, 0);
            cgRect.pivot = new Vector2(1, 0);
            cgRect.anchoredPosition = new Vector2(-25, 25);
            cgRect.sizeDelta = new Vector2(280, 110);
            controlsGuideGo.GetComponent<Image>().color = new Color(0.06f, 0.08f, 0.11f, 0.85f);

            var guideText = CreateText(controlsGuideGo.transform, "GuideText",
                "<b>CONTROLES TÁCTICOS:</b>\n" +
                "• <b>WASD:</b> Desplazamiento\n" +
                "• <b>Shift:</b> Correr (Sprint)\n" +
                "• <b>Ratón:</b> Rotar visión\n" +
                "• <b>E:</b> Interactuar con zonas\n" +
                "• <b>Esc:</b> Liberar cursor",
                11, FontStyles.Normal, new Color(0.85f, 0.88f, 0.92f), fontAsset);
            guideText.rectTransform.anchoredPosition = new Vector2(15, -12);
        }
        #endregion

        #region Helpers de Geometría
        private static GameObject CreateBox(string name, Transform parent, Vector3 pos, Vector3 size, Material mat)
        {
            var go = GameObject.CreatePrimitive(PrimitiveType.Cube);
            go.name = name;
            go.transform.SetParent(parent, false);
            go.transform.position = pos;
            go.transform.localScale = size;
            go.GetComponent<MeshRenderer>().sharedMaterial = mat;
            return go;
        }

        private static GameObject CreateCylinder(string name, Transform parent, Vector3 pos, Vector3 scale, Material mat)
        {
            var go = GameObject.CreatePrimitive(PrimitiveType.Cylinder);
            go.name = name;
            go.transform.SetParent(parent, false);
            go.transform.position = pos;
            go.transform.localScale = scale;
            go.GetComponent<MeshRenderer>().sharedMaterial = mat;
            return go;
        }

        private static void BuildCeilingLamp(Transform parent, Vector3 pos, Dictionary<string, Material> mats)
        {
            var fixture = CreateBox("CeilingLamp", parent, pos, new Vector3(1.2f, 0.08f, 0.4f), mats["Mat_UTOP_Metal_Dark"]);
            CreateBox("Bulb_Panel", fixture.transform, pos - new Vector3(0, 0.04f, 0), new Vector3(1.0f, 0.03f, 0.28f), mats["Mat_UTOP_Ceiling_Light"]);

            var lightObj = new GameObject("PointLight");
            lightObj.transform.SetParent(fixture.transform, false);
            lightObj.transform.position = pos - new Vector3(0, 0.2f, 0);
            var l = lightObj.AddComponent<Light>();
            l.type = LightType.Point;
            l.range = 8.5f;
            l.intensity = 1.35f;
            l.color = new Color(1f, 0.98f, 0.94f);
        }

        private static void BuildOfficeChair(Transform parent, Vector3 pos, Dictionary<string, Material> mats, float rotY = 0f)
        {
            var chair = new GameObject("Office_Chair");
            chair.transform.SetParent(parent, false);
            chair.transform.position = pos;
            chair.transform.rotation = Quaternion.Euler(0, rotY, 0);

            // Asiento
            CreateBox("Seat", chair.transform, pos + new Vector3(0, 0.45f, 0), new Vector3(0.55f, 0.08f, 0.55f), mats["Mat_UTOP_Fabric_Grey"]);
            // Respaldo
            CreateBox("Backrest", chair.transform, pos + new Vector3(0, 0.82f, -0.24f), new Vector3(0.5f, 0.65f, 0.08f), mats["Mat_UTOP_Fabric_Grey"]);
            // Pata central y ruedas
            CreateCylinder("Leg", chair.transform, pos + new Vector3(0, 0.22f, 0), new Vector3(0.08f, 0.22f, 0.08f), mats["Mat_UTOP_Metal_Dark"]);
        }

        private static void BuildExecutiveChair(Transform parent, Vector3 pos, Dictionary<string, Material> mats, float rotY = 0f)
        {
            var chair = new GameObject("Executive_Chair");
            chair.transform.SetParent(parent, false);
            chair.transform.position = pos;
            chair.transform.rotation = Quaternion.Euler(0, rotY, 0);

            // Asiento de piel
            CreateBox("Seat", chair.transform, pos + new Vector3(0, 0.48f, 0), new Vector3(0.68f, 0.12f, 0.65f), mats["Mat_UTOP_Fabric_Navy"]);
            // Respaldo alto
            CreateBox("Backrest", chair.transform, pos + new Vector3(0, 1.0f, -0.28f), new Vector3(0.64f, 0.95f, 0.12f), mats["Mat_UTOP_Fabric_Navy"]);
            // Apoyabrazos
            CreateBox("Arm_L", chair.transform, pos + new Vector3(-0.36f, 0.72f, 0), new Vector3(0.08f, 0.24f, 0.45f), mats["Mat_UTOP_Metal_Dark"]);
            CreateBox("Arm_R", chair.transform, pos + new Vector3(0.36f, 0.72f, 0), new Vector3(0.08f, 0.24f, 0.45f), mats["Mat_UTOP_Metal_Dark"]);
        }

        private static void BuildCouch(Transform parent, Vector3 pos, Dictionary<string, Material> mats)
        {
            var couch = new GameObject("Waiting_Couch");
            couch.transform.SetParent(parent, false);
            couch.transform.position = pos;

            CreateBox("Couch_Base", couch.transform, pos + new Vector3(0, 0.22f, 0), new Vector3(2.4f, 0.44f, 0.85f), mats["Mat_UTOP_Fabric_Navy"]);
            CreateBox("Couch_Back", couch.transform, pos + new Vector3(0, 0.65f, -0.35f), new Vector3(2.4f, 0.5f, 0.22f), mats["Mat_UTOP_Fabric_Navy"]);
            CreateBox("Couch_Arm_L", couch.transform, pos + new Vector3(-1.25f, 0.45f, 0), new Vector3(0.18f, 0.35f, 0.85f), mats["Mat_UTOP_Fabric_Navy"]);
            CreateBox("Couch_Arm_R", couch.transform, pos + new Vector3(1.25f, 0.45f, 0), new Vector3(0.18f, 0.35f, 0.85f), mats["Mat_UTOP_Fabric_Navy"]);
        }

        private static TextMeshProUGUI CreateText(Transform parent, string name, string content, float size, FontStyles style, Color color, TMP_FontAsset font)
        {
            var go = new GameObject(name, typeof(RectTransform), typeof(TextMeshProUGUI));
            go.transform.SetParent(parent, false);
            var rect = go.GetComponent<RectTransform>();
            rect.anchorMin = new Vector2(0, 1);
            rect.anchorMax = new Vector2(0, 1);
            rect.pivot = new Vector2(0, 1);

            var tmp = go.GetComponent<TextMeshProUGUI>();
            if (font != null) tmp.font = font;
            tmp.text = content;
            tmp.fontSize = size;
            tmp.fontStyle = style;
            tmp.color = color;
            tmp.extraPadding = true;
            return tmp;
        }
        #endregion

        #region Build Settings
        private static void UpdateBuildSettings()
        {
            var scenes = new List<EditorBuildSettingsScene>
            {
                new EditorBuildSettingsScene("Assets/_Project/Scenes/MainMenu/MainMenu.unity", true),
                new EditorBuildSettingsScene("Assets/_Project/Scenes/BaseUTOP/BaseUTOP.unity", true),
                new EditorBuildSettingsScene("Assets/Scenes/SampleScene.unity", true)
            };
            EditorBuildSettings.scenes = scenes.ToArray();
            Debug.Log("<color=green>[BaseUTOP] Build Settings actualizado: 0. MainMenu, 1. BaseUTOP, 2. SampleScene.</color>");
        }
        #endregion
    }
}
#endif
