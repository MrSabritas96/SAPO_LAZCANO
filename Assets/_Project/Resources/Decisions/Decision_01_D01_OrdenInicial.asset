  m_Name: Decision_01_D01_OrdenInicial
  m_EditorClassIdentifier: Assembly-CSharp::SimuladorBloqueos.Decisions.DecisionData
  decisionId: D01_OrdenInicial
  order: 1
  stageName: Orden inicial del superior
  context: "Te encuentras en el Primer Piso de la UTOP frente al Capit\xE1n Comandante. Reportes de radio informan que columnas de manifestantes (mineros, cholitas y ponchos rojos) bloquean la pendiente de la Calle Jun\xEDn frente al recinto policial."
  question: "\xBFC\xF3mo recepcionas y estructuras la orden operativa inicial del Capit\xE1n antes de bajar al Patio de Honor?"
  kind: 0
  shuffleOptions: 1
  primaryCriterion: 4
  hasSecondaryCriterion: 1
  secondaryCriterion: 1
  secondaryShare: 0.35
  options:
  - id: D01_EXC
    text: "Confirmar alcance del mandato, reglas de uso proporcional de la fuerza, puntos cr\xEDticos del recinto y cadena de reporte antes de movilizar a la tropa."
    classification: 0
    score: 100
    immediateConsequence: "Queda establecida con claridad la misi\xF3n defensiva, el marco legal vigente y el canal de mando con el Capit\xE1n."
    variableEffects:
    - variable: 2
      delta: 10
    - variable: 1
      delta: 8
    deferredConsequences: []
    setFlags:
    - D01_CLEAR_MANDATE
    criticalViolation: 0
    reactionTag: D01_BRIEFING_OK
    numericValue: 0
  - id: D01_GOOD
    text: "Acusar recibo r\xE1pido de la orden priorizando la contenci\xF3n del per\xEDmetro exterior y bajar de inmediato a formar al personal."
    classification: 1
    score: 88
    immediateConsequence: "Se inicia el alistamiento con rapidez, aunque algunos detalles de enlace secundario deber\xE1n precisarse en el patio."
    variableEffects:
    - variable: 1
      delta: 5
    deferredConsequences: []
    setFlags: []
    criticalViolation: 0
    reactionTag: D01_BRIEFING_FAST
    numericValue: 0
  - id: D01_MOD
    text: "Retrasar la salida discutiendo atribuciones administrativas secundarias mientras el bloqueo se aproxima al p\xF3rtico."
    classification: 2
    score: 68
    immediateConsequence: "Se pierde tiempo valioso de preparaci\xF3n inicial y aumenta la presi\xF3n sobre la guardia de entrada."
    variableEffects:
    - variable: 6
      delta: 8
    - variable: 1
      delta: -6
    deferredConsequences:
    - id: DEF_D01_LATE_PREP
      afterDecisions: 2
      description: "El retraso en la recepci\xF3n de la orden inicial redujo el margen de organizaci\xF3n de los puestos en el patio."
      effects:
      - variable: 3
        delta: -5
      setFlag: 
      scoreDelta: -3
      criterion: 4
    setFlags: []
    criticalViolation: 0
    reactionTag: D01_BRIEFING_DELAY
    numericValue: 0
  - id: D01_GRAVE
    text: "Ignorar los lineamientos de gradualidad del Capit\xE1n y ordenar por cuenta propia el despeje forzoso inmediato de toda la Calle Jun\xEDn."
    classification: 3
    score: 40
    immediateConsequence: "Incumplimiento grave de la cadena de mando y de los protocolos de actuaci\xF3n proporcional de la UTOP."
    variableEffects:
    - variable: 5
      delta: -15
