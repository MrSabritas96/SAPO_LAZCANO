  m_EditorClassIdentifier: Assembly-CSharp::SimuladorBloqueos.Decisions.DecisionData
  decisionId: D02_CantidadEfectivos
  order: 2
  stageName: Cantidad de efectivos
  context: "En la Cuadra de Tropa N\xB0 1 aguardan 30 efectivos UTOP disponibles. Debes definir cu\xE1ntos efectivos conformar\xE1n el contingente activo para proteger las instalaciones, mantener observaci\xF3n y asegurar las comunicaciones sin agotar la reserva."
  question: "\xBFCu\xE1ntos efectivos seleccionas para conformar el contingente operativo en el Patio de Honor?"
  kind: 1
  shuffleOptions: 0
  primaryCriterion: 2
  hasSecondaryCriterion: 0
  secondaryCriterion: 4
  secondaryShare: 0
  options:
  - id: D02_5
    text: Seleccionar 5 efectivos UTOP.
    classification: 2
    score: 95
    immediateConsequence: "Solo 5 efectivos salen al Patio de Honor. La cantidad resulta insuficiente para cubrir simult\xE1neamente protecci\xF3n, observaci\xF3n y comunicaciones."
    variableEffects:
    - variable: 0
      delta: -22
    - variable: 1
      delta: -14
    - variable: 3
      delta: -10
    deferredConsequences:
    - id: DEF_D02_5_FATIGUE
      afterDecisions: 3
      description: "La escasez de personal (solo 5 efectivos asignados en la Decisi\xF3n 2) sobrecarga los puestos de guardia y deja flancos sin relevo."
