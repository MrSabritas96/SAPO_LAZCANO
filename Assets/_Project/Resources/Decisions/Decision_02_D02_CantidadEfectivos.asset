      - variable: 1
        delta: -8
      - variable: 5
        delta: -6
      setFlag: CONTINGENT_OVERLOADED
      scoreDelta: -4
      criterion: 2
    setFlags:
    - D02_UNDERSTAFFED_5
    criticalViolation: 0
    reactionTag: D02_COUNT_5
    numericValue: 5
  - id: D02_15
    text: Seleccionar 15 efectivos UTOP.
    classification: 0
    score: 100
    immediateConsequence: "15 efectivos forman en el Patio de Honor: equilibrio \xF3ptimo entre cobertura perimetral, observaci\xF3n, enlace y reserva org\xE1nica en cuadra."
    variableEffects:
