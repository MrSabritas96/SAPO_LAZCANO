  options:
  - id: D05_EXC
    text: "Pasar revista f\xEDsica de sujeci\xF3n de cascos, estado de escudos, identificaci\xF3n visible de cada efectivo y recordar la prohibici\xF3n de actuar de forma aislada."
    classification: 0
    score: 100
