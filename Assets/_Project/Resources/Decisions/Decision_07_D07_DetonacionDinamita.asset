    reactionTag: D07_DYNAMITE_SAFE
    numericValue: 0
  - id: D07_GOOD
    text: "Mantener al personal agazapado tras la l\xEDnea de escudos dentro del umbral del garaje y reportar la detonaci\xF3n por radio."
    classification: 1
    score: 86
    immediateConsequence: "Se evita da\xF1o directo al personal policial, aunque la proximidad al umbral mantiene cierta exposici\xF3n ac\xFAstica."
    variableEffects:
    - variable: 5
      delta: 6
    - variable: 1
      delta: 6
    deferredConsequences: []
    setFlags: []
