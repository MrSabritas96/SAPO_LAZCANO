  decisionId: D12_FalloComunicaciones
  order: 12
  stageName: "Fallo o saturaci\xF3n de comunicaciones"
  context: "En el momento de mayor actividad operativa, el canal principal de radio presenta interferencia y saturaci\xF3n entre el P\xF3rtico, Observaci\xF3n y la Sala de Operaciones."
  question: "\xBFC\xF3mo restableces la coordinaci\xF3n y el mando ante la saturaci\xF3n del canal de radio?"
  kind: 0
  shuffleOptions: 1
  primaryCriterion: 4
  hasSecondaryCriterion: 1
  secondaryCriterion: 2
  secondaryShare: 0.3
  options:
  - id: D12_EXC
    text: "Conmutar de inmediato al canal t\xE1ctico de respaldo preasignado, activar enlaces por estafeta visual en el Patio de Honor e imponer disciplina de radio."
    classification: 0
    score: 100
    immediateConsequence: "Se recupera el 100% del enlace entre la Sala de Operaciones, Observaci\xF3n y la l\xEDnea de contenci\xF3n en menos de 30 segundos."
