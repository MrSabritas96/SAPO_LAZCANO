  m_Name: Decision_13_D13_DesescalamientoYCierre
  m_EditorClassIdentifier: Assembly-CSharp::SimuladorBloqueos.Decisions.DecisionData
  decisionId: D13_DesescalamientoYCierre
  order: 13
  stageName: Desescalamiento y cierre
  context: "Tras la contenci\xF3n perimetral y la atenci\xF3n humanitaria, la tensi\xF3n en la Calle Jun\xEDn disminuye y los voceros de los manifestantes inician el repliegue pac\xEDfico cuesta abajo."
  question: "\xBFC\xF3mo conduces el desescalamiento final y el cierre del operativo de la UTOP?"
  kind: 0
  shuffleOptions: 1
  primaryCriterion: 1
  hasSecondaryCriterion: 1
  secondaryCriterion: 4
  secondaryShare: 0.4
  options:
  - id: D13_EXC
    text: "Facilitar la desconcentraci\xF3n pac\xEDfica manteniendo actitud preventiva no provocadora, replegar gradualmente al contingente a formaci\xF3n 3x10 en el Patio de Honor, verificar novedades de personal/armamento y elevar el parte final al Capit\xE1n."
    classification: 0
    score: 100
    immediateConsequence: "Los manifestantes se retiran en orden por la Calle Jun\xEDn; la tropa UTOP forma en el Patio de Honor y el operativo concluye con \xE9xito institucional."
    variableEffects:
    - variable: 5
      delta: 16
    - variable: 6
      delta: -20
    - variable: 7
      delta: 100
    deferredConsequences: []
    setFlags: []
    criticalViolation: 0
    reactionTag: D13_CLOSE_EXCELLENT
    numericValue: 0
  - id: D13_GOOD
    text: "Mantener la guardia en el p\xF3rtico hasta que el \xFAltimo grupo se aleje y luego ordenar el retorno directo a la Cuadra de Tropa 1."
    classification: 1
    score: 88
    immediateConsequence: Cierre seguro del operativo, aunque sin pasar revista formal conjunta antes de romper filas.
    variableEffects:
    - variable: 5
      delta: 10
    - variable: 6
      delta: -12
    deferredConsequences: []
    setFlags: []
    criticalViolation: 0
    reactionTag: D13_CLOSE_GOOD
    numericValue: 0
  - id: D13_MOD
    text: "Retirar a todo el personal abruptamente sin verificar el recuento de equipo en la Sala de Armas ni dejar guardia m\xEDnima en el acceso."
    classification: 2
    score: 60
    immediateConsequence: "Desorden administrativo en la devoluci\xF3n de equipo y descuido temporal de la vigilancia del cuartel."
    variableEffects:
    - variable: 4
      delta: -12
    - variable: 1
      delta: -10
    deferredConsequences: []
    setFlags: []
    criticalViolation: 0
    reactionTag: D13_CLOSE_HASTY
    numericValue: 0
  - id: D13_GRAVE
    text: "Ordenar la persecuci\xF3n de los manifestantes que ya se est\xE1n retirando pac\xEDficamente por la Calle Jun\xEDn."
    classification: 3
    score: 30
    immediateConsequence: "Reactivaci\xF3n innecesaria e ilegal del conflicto cuando la situaci\xF3n ya estaba desescalada."
